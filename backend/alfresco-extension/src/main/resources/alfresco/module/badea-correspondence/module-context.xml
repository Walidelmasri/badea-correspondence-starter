<?xml version="1.0" encoding="UTF-8"?>

<beans
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
        Alfresco authentication adapter.

        Authentication remains owned by Alfresco / AD.
    -->
    <bean
        id="badeaCorrespondenceAuthenticatedUserProvider"
        class="org.badea.correspondence.infrastructure.alfresco.AlfrescoAuthenticatedUserProvider"
        lazy-init="true">

        <constructor-arg ref="AuthenticationService" />
    </bean>

    <!--
        Resolves the authenticated user's correspondence role
        from dedicated Alfresco groups.
    -->
    <bean
        id="badeaCorrespondenceActorRoleResolver"
        class="org.badea.correspondence.infrastructure.alfresco.AlfrescoCorrespondenceActorRoleResolver"
        lazy-init="true">

        <constructor-arg ref="authorityService" />

        <constructor-arg
            ref="badeaCorrespondenceAuthenticatedUserProvider" />
    </bean>

    <!--
        Oracle UCP datasource shared by correspondence directory adapters.

        Environment-backed and lazy so Oracle configuration must not
        prevent the core Alfresco/DMS repository from starting.
    -->
    <bean
        id="badeaCorrespondenceEmployeeDirectoryDataSource"
        class="org.badea.correspondence.infrastructure.oracle.OracleEmployeeDirectoryDataSourceFactory"
        factory-method="create"
        lazy-init="true">

        <constructor-arg
            value="#{systemEnvironment['BADEA_CORRESPONDENCE_DB_URL']}" />

        <constructor-arg
            value="#{systemEnvironment['BADEA_CORRESPONDENCE_DB_USERNAME']}" />

        <constructor-arg
            value="#{systemEnvironment['BADEA_CORRESPONDENCE_DB_PASSWORD']}" />
    </bean>

    <!--
        Oracle employee directory.
    -->
    <bean
        id="badeaCorrespondenceEmployeeDirectory"
        class="org.badea.correspondence.infrastructure.oracle.OracleEmployeeDirectory"
        lazy-init="true">

        <constructor-arg
            ref="badeaCorrespondenceEmployeeDirectoryDataSource" />
    </bean>

    <!--
        Oracle correspondence department directory.
    -->
    <bean
        id="badeaCorrespondenceDepartmentDirectory"
        class="org.badea.correspondence.infrastructure.oracle.OracleDepartmentDirectory"
        lazy-init="true">

        <constructor-arg
            ref="badeaCorrespondenceEmployeeDirectoryDataSource" />
    </bean>

    <!--
        Current authenticated employee application service.
    -->
    <bean
        id="badeaCorrespondenceCurrentEmployeeService"
        class="org.badea.correspondence.application.CurrentEmployeeService"
        lazy-init="true">

        <constructor-arg
            ref="badeaCorrespondenceAuthenticatedUserProvider" />

        <constructor-arg
            ref="badeaCorrespondenceEmployeeDirectory" />
    </bean>

    <!--
        Correspondence department application service.

        Used both by the department-list endpoint and workflow
        target-department validation.
    -->
    <bean
        id="badeaCorrespondenceDepartmentService"
        class="org.badea.correspondence.application.CorrespondenceDepartmentService"
        lazy-init="true">

        <constructor-arg
            ref="badeaCorrespondenceDepartmentDirectory" />
    </bean>

    <!--
        Current authenticated employee endpoint.
    -->
    <bean
        id="webscript.org.badea.correspondence.current-employee.get"
        class="org.badea.correspondence.webscript.CurrentEmployeeWebScript"
        parent="webscript"
        lazy-init="true">

        <constructor-arg
            ref="badeaCorrespondenceCurrentEmployeeService" />
    </bean>

    <!--
        Registers the BADEA Presidency Correspondence model.
    -->
    <bean
        id="badeaCorrespondenceDictionaryBootstrap"
        parent="dictionaryModelBootstrap"
        depends-on="dictionaryBootstrap">

        <property name="models">
            <list>
                <value>alfresco/module/badea-correspondence/model/correspondence-model.xml</value>
            </list>
        </property>
    </bean>

    <!--
        Locates the manually provisioned Correspondence root
        and department folders.
    -->
    <bean
        id="badeaCorrespondenceFolderLocator"
        class="org.badea.correspondence.infrastructure.alfresco.CorrespondenceFolderLocator">

        <constructor-arg ref="siteService" />
        <constructor-arg ref="nodeService" />

        <!--
            Preserve the real existing Alfresco site short name,
            including its spelling.
        -->
        <constructor-arg
            value="badea-instituional-documents" />

        <constructor-arg
            value="Correspondence" />
    </bean>

    <!--
        UUID -> bc:correspondence node lookup.
    -->
    <bean
        id="badeaCorrespondenceNodeLocator"
        class="org.badea.correspondence.infrastructure.alfresco.CorrespondenceNodeLocator">

        <constructor-arg ref="nodeService" />

        <constructor-arg
            ref="badeaCorrespondenceFolderLocator" />
    </bean>

    <!--
        UTC audit clock.
    -->
    <bean
        id="badeaCorrespondenceClock"
        class="java.time.Clock"
        factory-method="systemUTC" />

    <!--
        Alfresco correspondence persistence adapter.
    -->
    <bean
        id="badeaCorrespondenceRepository"
        class="org.badea.correspondence.infrastructure.alfresco.AlfrescoCorrespondenceRepository">

        <constructor-arg ref="nodeService" />

        <constructor-arg
            ref="badeaCorrespondenceFolderLocator" />

        <constructor-arg
            ref="badeaCorrespondenceNodeLocator" />

        <constructor-arg
            ref="badeaCorrespondenceClock" />
    </bean>

    <!--
        Pure workflow state machine.
    -->
    <bean
        id="badeaCorrespondenceWorkflowService"
        class="org.badea.correspondence.workflow.CorrespondenceWorkflowService" />

    <!--
        Correspondence-specific authorization rules.
    -->
    <bean
        id="badeaCorrespondenceAccessAuthorizer"
        class="org.badea.correspondence.application.CorrespondenceAccessAuthorizer" />

    <!--
        Workflow transition orchestration.

        Lazy because it now depends on the Oracle-backed department
        service. Oracle availability must not become an Alfresco
        startup dependency.
    -->
    <bean
        id="badeaCorrespondenceTransitionService"
        class="org.badea.correspondence.application.CorrespondenceTransitionService"
        lazy-init="true">

        <constructor-arg
            ref="badeaCorrespondenceWorkflowService" />

        <constructor-arg
            ref="badeaCorrespondenceAccessAuthorizer" />

        <constructor-arg
            ref="badeaCorrespondenceDepartmentService" />

        <constructor-arg
            ref="badeaCorrespondenceRepository" />
    </bean>

    <!--
        Authenticated draft creation endpoint.
    -->
    <bean
        id="webscript.org.badea.correspondence.create-correspondence.post"
        class="org.badea.correspondence.webscript.CreateCorrespondenceWebScript"
        parent="webscript"
        lazy-init="true">

        <constructor-arg
            ref="badeaCorrespondenceCurrentEmployeeService" />

        <constructor-arg
            ref="badeaCorrespondenceRepository" />
    </bean>

    <!--
        Authenticated workflow transition endpoint.
    -->
    <bean
        id="webscript.org.badea.correspondence.transition-correspondence.post"
        class="org.badea.correspondence.webscript.TransitionCorrespondenceWebScript"
        parent="webscript"
        lazy-init="true">

        <constructor-arg
            ref="badeaCorrespondenceCurrentEmployeeService" />

        <constructor-arg
            ref="badeaCorrespondenceActorRoleResolver" />

        <constructor-arg
            ref="badeaCorrespondenceTransitionService" />
    </bean>

    <!--
        Authenticated routing-department endpoint.
    -->
    <bean
        id="webscript.org.badea.correspondence.departments.get"
        class="org.badea.correspondence.webscript.DepartmentsWebScript"
        parent="webscript"
        lazy-init="true">

        <constructor-arg
            ref="badeaCorrespondenceDepartmentService" />
    </bean>

</beans>