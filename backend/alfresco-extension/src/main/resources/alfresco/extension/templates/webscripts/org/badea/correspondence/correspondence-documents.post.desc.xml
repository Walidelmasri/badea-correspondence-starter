<?xml version="1.0" encoding="UTF-8"?>

<webscript>
    <shortname>Upload BADEA Correspondence Document</shortname>

    <description>
        Uploads a PDF source document to a correspondence
        draft owned by the authenticated Director.
    </description>

    <url>/badea/correspondence/{technicalId}/documents</url>

    <authentication>user</authentication>

    <transaction>required</transaction>

    <format default="json">argument</format>
</webscript>